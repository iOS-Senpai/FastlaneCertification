default_platform(:ios)

PROJECT = "FastlaneCertification.xcodeproj"
SCHEME = "FastlaneCertification"

platform :ios do
  desc "Run unit tests for CI"
  lane :unit_tests do
    run_tests(
      project: PROJECT,
      scheme: SCHEME,
      only_testing: ["FastlaneCertificationTests"]
    )
  end

  desc "Build app for CI without distribution signing"
  lane :build do
    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      clean: true,
      skip_codesigning: true,
      skip_package_ipa: true,
      archive_path: "build/FastlaneCertification.xcarchive"
    )
  end

  desc "Validate signing configuration"
  lane :signing_check do
    UI.message("Signing stage started")

    signing_directory = File.expand_path("../signing", __dir__)

    unless File.directory?(signing_directory)
      UI.user_error!("Signing assets directory is missing")
    end

    unless ENV["MOCK_SIGNING_SECRET"]
      UI.user_error!("Signing secret is missing")
    end

    UI.success("Signing assets are available")
  end

  desc "Run complete CI validation"
  lane :ci do
    unit_tests
    build
  end

  desc "Run release pipeline simulation"
  lane :release do
    unit_tests
    build
    signing_check

    UI.message("Distribution signing boundary validated")
    UI.success("Release pipeline simulation completed")
  end
end